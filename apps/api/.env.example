NODE_ENV=development
API_PORT=4000
JWT_SECRET=replace_this_with_a_long_random_secret
APP_WEB_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ticketsplice

# Optional SMTP config for real email sending.
# If omitted, verification links are logged to server output in development.
# EMAIL_FROM=no-reply@ticketsplice.com
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=your_smtp_password

# Optional Google OAuth config. When set, Google login is enabled.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/auth/oauth/google/callback